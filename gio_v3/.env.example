# ── Base de datos ─────────────────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://tu-db.turso.io
TURSO_AUTH_TOKEN=eyJ...

# ── Flask ─────────────────────────────────────────────────────────────────────
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTO

# ── Google Gemini / IA ───────────────────────────────────────────────────────
# Obtén tu key gratis en aistudio.google.com → "Get API key"
GEMINI_API_KEY=AIza...

# ── Solo Railway (volumen persistente) ───────────────────────────────────────
# DATABASE_PATH=/data/pipeline.db
# UPLOADS_DIR se deriva automáticamente: el MISMO directorio que contiene
# DATABASE_PATH (/data) — solo defínela si necesitas un destino distinto.
# UPLOADS_DIR=/data
